# ==============================================================
# SMART FEEDER BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi '.env' lalu sesuaikan nilainya.
# ==============================================================

# Konfigurasi Research Data Gateway (Raspberry Pi di Living Lab)
GATEWAY_API_BASE_URL="http://127.0.0.1:18088"
GATEWAY_DATASET_ID="your_dataset_id_here"
GATEWAY_API_KEY="your_gateway_api_key_here"

# Database Backend: 100% Pure Cloud Firestore (Firebase Admin SDK)
# Pastikan file kredensial serviceAccountKey.json diletakkan di dalam folder secrets/

# Admin & Device Security
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_admin_password_here"
JWT_SECRET="your_random_secret_key_for_jwt_tokens"
DEVICE_API_KEY="your_esp32_device_api_key_here"
